{
  "name": "v1_bod",
  "description": "Robustness check: v1_equal_geometric indicator set with Benefit of the Doubt (BoD/DEA) weighting instead of equal weights",
  "methodology": {
    "normalisation": "min_max",
    "within_pillar_agg": "bod",
    "across_pillar_agg": "none",
    "weighting": "bod",
    "bod_weighting": true,
    "conflict_weighting": false,
    "bod_weight_flex": 0.5
  },
  "countries": {
    "kenya": {
      "id_cols": ["adm1_pcode", "adm1_name"],
      "population_col": "population_total",
      "exclude_regions": [],
      "imputation": "mean",
      "pillar_map": {
        "food_security": "pop_frac_3plus",
        "education":     "net_attendance_total",
        "health":        "health_fac_per_10k_pop",
        "economic":      "gcp_pc",
        "climate":       "rs_ndvi"
      },
      "bad_vars": ["pop_frac_3plus", "poverty_headcount_pct"],
      "conflict": {
        "indicators": ["total_fatalities_2025", "count_conflict_events_2025", "total_fatalities_per_1k_2025", "count_conflicts_events_per_1k_2025"],
        "labels": ["Total fatalities (2025)", "Total conflict events (2025)", "Fatalities per 1k pop (2025)", "Conflict events per 1k pop (2025)"]
      }
    },
    "somalia": {
      "id_cols": ["adm1_pcode", "adm1_name"],
      "population_col": "population_total",
      "exclude_regions": [],
      "imputation": "mean",
      "pillar_map": {
        "food_security": "pop_frac_3plus",
        "education":     "primary_school_net_attendance_total",
        "health":        "health_fac_per_10k_pop",
        "economic":      "poverty_headcount_pct",
        "climate":       "rs_ndvi"
      },
      "bad_vars": ["pop_frac_3plus", "poverty_headcount_pct"],
      "conflict": {
        "indicators": ["total_fatalities_2025", "count_conflict_events_2025", "total_fatalities_per_1k_2025", "count_conflicts_events_per_1k_2025"],
        "labels": ["Total fatalities (2025)", "Total conflict events (2025)", "Fatalities per 1k pop (2025)", "Conflict events per 1k pop (2025)"]
      }
    },
    "south_sudan": {
      "id_cols": ["adm1_pcode", "adm1_name"],
      "population_col": "population_total",
      "exclude_regions": ["SS00"],
      "imputation": "omit",
      "pillar_map": {
        "food_security": "pop_frac_3plus",
        "education":     "school_access_pop",
        "health":        "healthcare_access_pop",
        "economic":      "poverty_headcount_pct",
        "climate":       "rs_ndvi"
      },
      "bad_vars": ["pop_frac_3plus", "dropout_pct", "poverty_headcount_pct", "annual_cmb_mean"],
      "conflict": {
        "indicators": ["total_fatalities_2025", "count_conflict_events_2025", "total_fatalities_per_1k_2025", "count_conflicts_events_per_1k_2025"],
        "labels": ["Total fatalities (2025)", "Total conflict events (2025)", "Fatalities per 1k pop (2025)", "Conflict events per 1k pop (2025)"]
      }
    }
  }
}
