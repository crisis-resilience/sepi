{
  "name": "v1_aligned_equal_geometric",
  "description": "Equal weights — arithmetic mean within pillars, geometric mean across pillars — with curated country-specific indicator sets from the indicator alignment exercise",
  "robustness_variants": ["v1_aligned_zscore", "v1_aligned_bod"],
  "methodology": {
    "normalisation": "min_max",
    "within_pillar_agg": "arithmetic",
    "across_pillar_agg": "geometric",
    "weighting": "equal",
    "geometric_floor": 0.001,
    "conflict_weighting": false
  },
  "countries": {
    "kenya": {
      "id_cols": ["adm1_pcode", "adm1_name"],
      "population_col": "population_total",
      "exclude_regions": [],
      "pillars": {
        "education": {
          "indicators": ["primary_school_net_attendance_total", "net_attendance_total"],
          "polarity": [1, 1],
          "labels": ["Primary net attendance (%)", "Secondary net attendance (%)"]
        },
        "health": {
          "indicators": ["healthcare_access_pop", "health_fac_per_10k_pop", "hospitals_per_100k_pop"],
          "polarity": [1, 1, 1],
          "labels": ["Population with healthcare access (%)", "Health facilities per 10k pop", "Hospitals per 100k pop"]
        },
        "food_security": {
          "indicators": ["pop_frac_3plus"],
          "polarity": [-1],
          "labels": ["Population in IPC Phase 3+ (proportion)"]
        },
        "economic": {
          "indicators": ["poverty_headcount_pct", "gcp_pc"],
          "polarity": [-1, 1],
          "labels": ["Poverty headcount (%)", "Gross county product per capita (KSh)"]
        },
        "climate": {
          "indicators": ["rs_ndvi", "rs_soil_moist", "rs_fapar", "rs_pdsi"],
          "polarity": [1, 1, 1, 1],
          "labels": ["NDVI (remote sensing)", "Soil moisture (remote sensing)", "FAPAR (remote sensing)", "Palmer Drought Severity Index (remote sensing)"]
        }
      },
      "conflict": {
        "indicators": ["total_fatalities_2025", "count_conflict_events_2025", "total_fatalities_per_1k_2025", "count_conflicts_events_per_1k_2025"],
        "labels": ["Total fatalities (2025)", "Total conflict events (2025)", "Fatalities per 1k pop (2025)", "Conflict events per 1k pop (2025)"]
      }
    },
    "somalia": {
      "id_cols": ["adm1_pcode", "adm1_name"],
      "population_col": "population_total",
      "exclude_regions": [],
      "pillars": {
        "education": {
          "indicators": ["literacy_percent_total", "primary_school_net_attendance_total", "percent_highest_level_secondary_education"],
          "polarity": [1, 1, 1],
          "labels": ["Literacy rate (%)", "Primary net attendance (%)", "Secondary education attainment (%)"]
        },
        "health": {
          "indicators": ["healthcare_access_pop", "health_fac_per_10k_pop", "hospitals_per_100k_pop"],
          "polarity": [1, 1, 1],
          "labels": ["Population with healthcare access (%)", "Health facilities per 10k pop", "Hospitals per 100k pop"]
        },
        "food_security": {
          "indicators": ["pop_frac_3plus"],
          "polarity": [-1],
          "labels": ["Population in IPC Phase 3+ (proportion)"]
        },
        "economic": {
          "indicators": ["poverty_headcount_pct", "total_expenditure_usd"],
          "polarity": [-1, 1],
          "labels": ["Poverty headcount (%)", "Household expenditure (USD)"]
        },
        "climate": {
          "indicators": ["rs_ndvi", "rs_soil_moist", "rs_fapar", "rs_pdsi"],
          "polarity": [1, 1, 1, 1],
          "labels": ["NDVI (remote sensing)", "Soil moisture (remote sensing)", "FAPAR (remote sensing)", "Palmer Drought Severity Index (remote sensing)"]
        }
      },
      "conflict": {
        "indicators": ["total_fatalities_2025", "count_conflict_events_2025", "total_fatalities_per_1k_2025", "count_conflicts_events_per_1k_2025"],
        "labels": ["Total fatalities (2025)", "Total conflict events (2025)", "Fatalities per 1k pop (2025)", "Conflict events per 1k pop (2025)"]
      }
    },
    "south_sudan": {
      "id_cols": ["adm1_pcode", "adm1_name"],
      "population_col": "population_total",
      "exclude_regions": ["SS00"],
      "pillars": {
        "education": {
          "indicators": ["school_access_pop", "on_payroll_pct", "dropout_pct"],
          "polarity": [1, 1, -1],
          "labels": ["Population with school access (%)", "Teachers on payroll (%)", "Student dropout rate (%)"]
        },
        "health": {
          "indicators": ["healthcare_access_pop", "health_fac_per_10k_pop", "hospitals_per_100k_pop"],
          "polarity": [1, 1, 1],
          "labels": ["Population with healthcare access (%)", "Health facilities per 10k pop", "Hospitals per 100k pop"]
        },
        "food_security": {
          "indicators": ["pop_frac_3plus"],
          "polarity": [-1],
          "labels": ["Population in IPC Phase 3+ (proportion)"]
        },
        "economic": {
          "indicators": ["poverty_headcount_pct", "annual_cmb_mean"],
          "polarity": [-1, -1],
          "labels": ["Poverty headcount (%)", "Average annual CMB cost (USD)"]
        },
        "climate": {
          "indicators": ["rs_ndvi", "rs_soil_moist", "rs_fapar", "rs_pdsi"],
          "polarity": [1, 1, 1, 1],
          "labels": ["NDVI (remote sensing)", "Soil moisture (remote sensing)", "FAPAR (remote sensing)", "Palmer Drought Severity Index (remote sensing)"]
        }
      },
      "conflict": {
        "indicators": ["total_fatalities_2025", "count_conflict_events_2025", "total_fatalities_per_1k_2025", "count_conflicts_events_per_1k_2025"],
        "labels": ["Total fatalities (2025)", "Total conflict events (2025)", "Fatalities per 1k pop (2025)", "Conflict events per 1k pop (2025)"]
      }
    }
  }
}
